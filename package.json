{
  "name": "infoplist-usage-description-companion",
  "displayName": "Info.plist Usage Description Companion",
  "description": "Cross-checks Swift/Objective-C imports (CoreLocation, Contacts, Photos, etc.) against required NS*UsageDescription keys in Info.plist -- a common cause of App Store Connect rejection. No data leaves your editor.",
  "version": "0.1.0",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "ios",    "swift",    "infoplist",    "app-store"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-infoplist-usage-description-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-infoplist-usage-description-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "infoPlistUsageDescriptionCompanion.rescan",
        "title": "Info.plist Usage Description Companion: Rescan"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
